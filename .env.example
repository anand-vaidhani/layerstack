# PostgreSQL connection (local Homebrew Postgres in this repo's dev setup)
DATABASE_URL="postgresql://userid@127.0.0.1:5432/layerstack"

# Secret used to sign session cookies — generate with: openssl rand -hex 32
AUTH_SECRET=""

# Public URL of the app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe (optional — the app runs a labelled demo upgrade flow without them)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
